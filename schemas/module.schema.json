{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "module.schema.json",
  "title": "模块描述 v0.1",
  "type": "object",
  "required": ["id", "version", "name", "description", "category", "side_effects", "inputs", "outputs", "examples", "runtime"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "category": { "type": "string" },
    "side_effects": { "enum": ["none", "read", "network", "write"] },
    "interaction": { "enum": ["ask"] },
    "inputs":  { "type": "object", "additionalProperties": { "$ref": "workflow.schema.json#/$defs/port" } },
    "outputs": { "type": "object", "additionalProperties": { "$ref": "workflow.schema.json#/$defs/port" } },
    "errors": {
      "type": "array",
      "items": { "type": "object", "required": ["code", "when"],
                 "properties": { "code": { "type": "string" }, "when": { "type": "string" } } }
    },
    "examples": {
      "type": "array", "minItems": 1,
      "items": { "type": "object", "required": ["title", "input", "output"],
                 "properties": { "title": { "type": "string" }, "input": { "type": "object" }, "output": { "type": "object" } } }
    },
    "runtime": {
      "type": "object", "required": ["entry", "timeout_s"],
      "properties": { "entry": { "type": "string", "pattern": "^[^:]+\\.py:[A-Za-z_][A-Za-z0-9_]*$" },
                      "timeout_s": { "type": "number", "exclusiveMinimum": 0 },
                      "dry_run": { "type": "string", "pattern": "^[^:]+\\.py:[A-Za-z_][A-Za-z0-9_]*$" } }
    }
  }
}
